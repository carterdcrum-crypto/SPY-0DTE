# Required Webull sandbox credentials for the current collector.
# Never commit real values.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ENVIRONMENT=sandbox

# Collector settings
COLLECTOR_DB_PATH=/data/spy_0dte.sqlite
COLLECTOR_INTERVAL_SECONDS=60
COLLECTOR_IDLE_SLEEP_SECONDS=300
COLLECTOR_MARKET_OPEN_ET=09:45
COLLECTOR_MARKET_CLOSE_ET=16:00
START_COLLECTOR_IN_API=true
LOG_LEVEL=INFO

# Mobile control plane
CONTROL_DB_PATH=/data/spy_control.sqlite
GOOGLE_WEB_CLIENT_ID=
APP_ALLOWED_EMAILS=
# Generate a Fernet key and store it only as a Railway variable.
APP_ENCRYPTION_KEY=

# Fail-closed live-trading gates. Keep false until the production order
# executor is independently implemented, tested, and intentionally enabled.
ALLOW_LIVE_ORDERS=false
LIVE_ORDER_EXECUTOR_READY=false
