# Required Webull sandbox credentials for the current fallback collector.
# Never commit real values. Tradier production credentials are NOT required for
# autonomous PAPER/SHADOW execution.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ENVIRONMENT=sandbox

# Collector settings. The active near-ATM set is polled every 2 seconds while
# the full 0DTE contract list is refreshed once per minute. Transient provider
# failures back off automatically instead of hammering the API.
COLLECTOR_DB_PATH=/data/spy_0dte.sqlite
COLLECTOR_INTERVAL_SECONDS=2
COLLECTOR_MAX_BACKOFF_SECONDS=120
COLLECTOR_IDLE_SLEEP_SECONDS=300
COLLECTOR_MARKET_OPEN_ET=09:45
COLLECTOR_MARKET_CLOSE_ET=16:00
WEBULL_ACTIVE_CONTRACT_LIMIT=20
WEBULL_CONTRACT_REFRESH_SECONDS=60
START_COLLECTOR_IN_API=true
LOG_LEVEL=INFO

# Autonomous experimental paper trader. PAPER mode allows autonomous simulated
# entries and dynamic exits. SHADOW mode blocks new simulated entries while the
# runner still manages any already-open paper position to an exit.
START_PAPER_AUTOTRADER=true
PAPER_DELAYED_SIMULATION=true
PAPER_STARTING_CASH=115
PAPER_DB_PATH=/data/spy_paper.sqlite
PAPER_ENGINE_TICK_SECONDS=1

# Mobile control plane. APP_PREVIEW_MODE=true keeps the login-free paper build
# available and always locks LIVE. Set it false only after Google owner auth is
# configured for the authenticated Android build.
CONTROL_DB_PATH=/data/spy_control.sqlite
LIVE_RISK_DB_PATH=/data/spy_live_risk.sqlite
APP_PREVIEW_MODE=true
GOOGLE_WEB_CLIENT_ID=
APP_ALLOWED_EMAILS=
# Generate a Fernet key and store it only as a Railway variable.
APP_ENCRYPTION_KEY=

# Optional Tradier production market-data/account-readiness bridge. Leave both
# blank until the owner deliberately configures the live-alert workflow. Never
# put real broker secrets in GitHub or the APK.
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_ID=
LIVE_BROKER=tradier
MARKET_DATA_PROVIDER=auto

# The LIVE mode in this build is notification-only: the existing strategy/risk
# loop evaluates qualified setups, reconciles broker P&L/positions/pending orders,
# applies the owner-selected daily loss/gain/exposure/contract envelope, and sends
# an Android alert for review. It does not transmit a broker order.
#
# Legacy real-order gates stay false. They are not required for live alerts and
# do not enable anything in this notification-only path.
ALLOW_LIVE_ORDERS=false
LIVE_ORDER_EXECUTOR_READY=false
