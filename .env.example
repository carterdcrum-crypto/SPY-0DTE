# Webull OpenAPI credentials. The same SDK supports the delayed sandbox collector
# and the production account/trading surface. Never commit real values.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_ENVIRONMENT=sandbox
WEBULL_OPENAPI_TOKEN_DIR=/data/webull-openapi

# Collector settings. The active near-ATM set is polled every 2 seconds while
# the full 0DTE contract list is refreshed once per minute. Transient provider
# failures back off automatically instead of hammering the API.
COLLECTOR_DB_PATH=/data/spy_0dte.sqlite
COLLECTOR_INTERVAL_SECONDS=2
COLLECTOR_MAX_BACKOFF_SECONDS=120
COLLECTOR_IDLE_SLEEP_SECONDS=300
COLLECTOR_MARKET_OPEN_ET=09:45
COLLECTOR_MARKET_CLOSE_ET=16:00
WEBULL_ACTIVE_CONTRACT_LIMIT=20
WEBULL_CONTRACT_REFRESH_SECONDS=60
START_COLLECTOR_IN_API=true
LOG_LEVEL=INFO

# Autonomous experimental paper trader. PAPER mode allows autonomous simulated
# entries and dynamic exits. SHADOW mode blocks new simulated entries while the
# runner still manages any already-open paper position to an exit.
START_PAPER_AUTOTRADER=true
PAPER_DELAYED_SIMULATION=true
PAPER_STARTING_CASH=115
PAPER_DB_PATH=/data/spy_paper.sqlite
PAPER_ENGINE_TICK_SECONDS=1

# Mobile control plane. APP_PREVIEW_MODE=true keeps the login-free build usable
# for PAPER/SHADOW and visibly shows the LIVE trade button, but broker submission
# stays locked. Set it false only after Google owner auth is configured.
CONTROL_DB_PATH=/data/spy_control.sqlite
LIVE_RISK_DB_PATH=/data/spy_live_risk.sqlite
LIVE_TICKET_DB_PATH=/data/spy_live_tickets.sqlite
APP_PREVIEW_MODE=true
GOOGLE_WEB_CLIENT_ID=
APP_ALLOWED_EMAILS=
APP_ENCRYPTION_KEY=

# Confirmed LIVE broker path. Railway still makes the strategy/risk decision,
# but a production order is transmitted only after the authenticated owner taps
# TRADE, reviews the Webull preview, and taps CONFIRM TRADE for that exact order.
LIVE_BROKER=webull
LIVE_CONFIRMATION_TTL_SECONDS=45
LIVE_MAX_DATA_AGE_SECONDS=5
LIVE_MAX_FEED_DELAY_SECONDS=5

# Code-readiness and owner-consent gates. LIVE_ORDER_EXECUTOR_READY should become
# true only after the confirmed-submit adapter has passed deployment checks.
# ALLOW_LIVE_ORDERS is the final environment-level switch for production orders.
ALLOW_LIVE_ORDERS=false
LIVE_ORDER_EXECUTOR_READY=false

# Market data provider for the collector. A LIVE trade remains blocked when the
# feed is delayed beyond LIVE_MAX_FEED_DELAY_SECONDS. Webull production options
# require the appropriate OpenAPI real-time options market-data entitlement.
MARKET_DATA_PROVIDER=auto

# Optional legacy Tradier variables remain supported by older modules but are no
# longer the selected LIVE broker.
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_ID=
